{
  "name": "salarmehr/cosmopolitan",
  "description": "Super efficient application localisation",
  "type": "internationalisation",
  "license": "MIT",
  "homepage": "https://cosmo.miloun.com/?lang=php",
  "support": {
    "docs": "https://cosmo.miloun.com/api-reference/?lang=php",
    "issues": "https://github.com/salarmehr/cosmopolitan/issues",
    "source": "https://github.com/salarmehr/cosmopolitan"
  },
  "authors": [
    {
      "name": "Aiden Adrian",
      "email": "aiden@miloun.com"
    }
  ],
  "require": {
    "php": ">=8.4",
    "ext-intl": "*"
  },
  "autoload": {
    "psr-4": {
      "Miloun\\Cosmo\\": "src/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^8",
    "phpstan/phpstan": "^2.1"
  },
  "scripts": {
    "test": "@php -d error_reporting=-1 -d display_errors=1 vendor/bin/phpunit --do-not-cache-result --fail-on-risky --fail-on-warning",
    "analyse": "@php vendor/bin/phpstan analyse --no-progress --memory-limit=512M"
  }
}
